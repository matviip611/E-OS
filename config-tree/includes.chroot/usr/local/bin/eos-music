#!/usr/bin/env python3
# Тиха фонова музика E-OS: окремий потік "E-OS Music" у мікшері.
# Коли грає щось інше — гучність музики плавно приглушується.
import json, subprocess, time, os, signal
APP = "E-OS Music"
TRACK = "/usr/share/E-OS/background-music.mp3"
BASE, DUCKED = 35, 6
mpv = subprocess.Popen(["mpv", "--no-video", "--no-terminal", "--loop-file=inf",
                        f"--audio-client-name={APP}", f"--volume=100", TRACK])
signal.signal(signal.SIGTERM, lambda *a: (mpv.terminate(), os._exit(0)))

def inputs():
    try:
        out = subprocess.run(["pactl", "--format=json", "list", "sink-inputs"],
                             capture_output=True, text=True, timeout=5).stdout
        return json.loads(out)
    except Exception:
        return []

def vol(si):
    try:
        ch = list(si["volume"].values())[0]
        return float(ch["value_percent"].rstrip("%"))
    except Exception:
        return None

user_level, current, set_by_us = BASE, None, None
while mpv.poll() is None:
    sis = inputs()
    mine = [s for s in sis if s.get("properties", {}).get("application.name") == APP]
    others = [s for s in sis if s not in mine and not s.get("corked", False)]
    if mine:
        s = mine[0]; v = vol(s)
        if current is None:
            subprocess.run(["pactl", "set-sink-input-volume", str(s["index"]), f"{BASE}%"])
            current = set_by_us = BASE
        else:
            if v is not None and set_by_us is not None and abs(v - set_by_us) > 2 and not others:
                user_level = v           # користувач сам посунув повзунок
            target = DUCKED if others else user_level
            step = 3 if target > current else -3
            if abs(target - current) <= 3: current = target
            else: current += step
            if current != set_by_us:
                subprocess.run(["pactl", "set-sink-input-volume", str(s["index"]), f"{int(current)}%"])
                set_by_us = current
    time.sleep(0.5)

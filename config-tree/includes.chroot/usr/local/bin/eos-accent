#!/usr/bin/env python3
# Підбирає акцентний колір KDE зі шпалер
import sys, colorsys, subprocess
from PIL import Image
path = sys.argv[1] if len(sys.argv) > 1 else "/usr/share/wallpapers/E-OS/contents/images/1920x1080.jpg"
im = Image.open(path).convert("RGB").resize((64, 36))
best, bw = (85, 175, 87), 0.0
sr = sg = sb = tw = 0.0
for r, g, b in im.getdata():
    h, s, v = colorsys.rgb_to_hsv(r/255, g/255, b/255)
    w = s * (1 - abs(v - 0.65))
    sr += r*w; sg += g*w; sb += b*w; tw += w
if tw > 0: best = (int(sr/tw), int(sg/tw), int(sb/tw))
r, g, b = best
rgb = f"{r},{g},{b}"
def kw(group, key, val):
    subprocess.run(["kwriteconfig5", "--file", "kdeglobals", "--group", group, "--key", key, val])
kw("Colors:Selection", "BackgroundNormal", rgb)
for grp in ("Colors:View", "Colors:Window", "Colors:Button", "Colors:Selection", "Colors:Tooltip", "Colors:Complementary"):
    kw(grp, "DecorationFocus", rgb)
    kw(grp, "ForegroundActive", rgb)
kw("General", "AccentColor", rgb)
subprocess.run(["dbus-send", "--session", "--type=signal", "/KGlobalSettings",
                "org.kde.KGlobalSettings.notifyChange", "int32:0", "int32:0"])
